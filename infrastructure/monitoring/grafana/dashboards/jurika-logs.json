{
  "annotations": {"list": []},
  "editable": false,
  "schemaVersion": 39,
  "tags": ["jurika", "logs"],
  "title": "JURIKA Logs",
  "uid": "jurika-logs",
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "loki", "uid": "jurika-loki"},
        "query": "label_values({container=~\"jurika-.*\"}, service)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "level",
        "type": "custom",
        "query": "INFO,WARN,ERROR,DEBUG",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "Correlation ID",
        "current": {"text": "", "value": ""}
      },
      {
        "name": "workspaceId",
        "type": "textbox",
        "label": "Workspace ID",
        "current": {"text": "", "value": ""}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erreurs (5m)",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "loki", "uid": "jurika-loki"},
        "expr": "sum(count_over_time({service=~\"$service\", level=\"ERROR\"}[5m]))"
      }],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 50}]}}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (5m)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "loki", "uid": "jurika-loki"},
        "expr": "sum(count_over_time({service=~\"$service\", level=\"WARN\"}[5m]))"
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log rate par service (lines/s)",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "loki", "uid": "jurika-loki"},
        "expr": "sum by (service) (rate({service=~\"$service\"}[1m]))",
        "legendFormat": "{{service}}"
      }]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs",
      "gridPos": {"h": 20, "w": 24, "x": 0, "y": 10},
      "datasource": {"type": "loki", "uid": "jurika-loki"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "loki", "uid": "jurika-loki"},
        "expr": "{service=~\"$service\", level=~\"$level\"} |~ \"$correlationId\" |~ \"$workspaceId\""
      }],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
