{
  "annotations": {"list": []},
  "editable": false,
  "schemaVersion": 39,
  "tags": ["jurika", "jvm"],
  "title": "JURIKA JVM",
  "uid": "jurika-jvm",
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "jurika-prometheus"},
        "query": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Heap used (MB)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "jurika-prometheus"},
        "expr": "sum by (application) (jvm_memory_used_bytes{application=~\"$service\", area=\"heap\"}) / 1024 / 1024",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Threads vivants",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "jurika-prometheus"},
        "expr": "jvm_threads_live_threads{application=~\"$service\"}",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC pause time (s/s)",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "jurika-prometheus"},
        "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum{application=~\"$service\"}[5m]))",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU usage (%)",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "prometheus", "uid": "jurika-prometheus"},
        "expr": "100 * process_cpu_usage{application=~\"$service\"}",
        "legendFormat": "{{application}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    }
  ]
}
