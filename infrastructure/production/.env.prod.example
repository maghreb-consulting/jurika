# JURIKA -- Variables environnement PRODUCTION
# A copier en .env.prod et adapter

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jurika_db
POSTGRES_USER=jurika_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=jurika
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_VHOST=jurika

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG

# Eureka / Gateway
EUREKA_SERVER_URL=http://discovery:8761/eureka

# JWT (32+ chars random)
JWT_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_KEY_FOR_HS256_JWT
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=86400000

# AES (32+ chars random)
AES_SECRET_KEY=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_KEY_FOR_AES_256

# SMTP (production)
SMTP_HOST=smtp.jurika.ma
SMTP_PORT=587
SMTP_USER=noreply@jurika.ma
SMTP_PASSWORD=CHANGE_ME
SMTP_AUTH=true
SMTP_STARTTLS=true

# Twilio (SMS 2FA)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+212XXXXXXXXX

# Anthropic / OpenAI (RAG chatbot)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# ou
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
JURIKA_RAG_ENABLED=false

# CORS / Frontend
FRONTEND_URL=https://jurika.ma
API_BASE_URL=https://api.jurika.ma/api/v1
REALTIME_URL=https://realtime.jurika.ma

# Demo data (FALSE en prod !). Lot L0 (E16c) : JURIKA_DEMOSEED est la forme liee
# a jurika.demo-seed (liaison souple de Spring) ; JURIKA_DEMO_SEED ne l'etait pas.
JURIKA_DEMOSEED=false
