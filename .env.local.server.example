# ══════════════════════════════════════════════════════════════════
# JURIKA — .env.local.server (SERVEUR LOCAL pour DEMO directeur)
# ══════════════════════════════════════════════════════════════════
#
# Sprint Beta (pricing-deploy) — TASK 8.
#
# Copier en .env.local sur le serveur cible (Windows ou Linux) avant
# de lancer `scripts/start-local.{sh,ps1}`. Toutes les valeurs CHANGE_ME
# doivent etre remplacees ; les autres ont des defauts production-safe
# pour une demo en LAN.

# ─── Reseau ───────────────────────────────────────────────────────
# IP LAN du serveur ou hostname resolvable depuis les postes clients.
# Stripe Checkout renverra ici, donc doit etre joignable depuis le
# navigateur de la machine qui teste le paiement (= la meme).
JURIKA_LAN_HOST=192.168.1.42

# Profil Spring : prod-local active la validation stricte des proprietes,
# desactive H2/ddl-auto, force l'utilisation des vraies cles JWT.
SPRING_PROFILES_ACTIVE=prod-local
JURIKA_ENV=local

# --- Corpus des modeles (lot L2) -----------------------------------
# Dossier DATE du corpus de reference, monte en lecture seule dans ai-service
# (/corpus). Obligatoire, sans repli : absent ou defectueux, ai-service ne
# demarre pas. Nouvelle version du corpus = nouveau dossier date, puis
# recreation d'ai-service. Le dossier doit etre lisible par l'uid 1000.
JURIKA_CORPUS_DIR=/home/jurika/corpus/CORPUS_2026-10-03

# ─── PostgreSQL 16 ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jurika_db
POSTGRES_USER=jurika_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password_min_24_chars
# Role d'execution des services (non proprietaire, NOSUPERUSER, NOBYPASSRLS) :
# mot de passe DEDIE, obligatoire, distinct de POSTGRES_PASSWORD (lot L0).
JURIKA_APP_PASSWORD=CHANGE_ME_jurika_app_password_min_24_chars
BILLING_DB_NAME=jurika_billing

# ─── Redis 7.4 ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password_min_24_chars

# ─── RabbitMQ 4.0 ───────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=jurika
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password_min_24_chars
RABBITMQ_VHOST=jurika

# ─── MinIO (Documents PDF / uploads) ────────────────────────────
MINIO_ROOT_USER=jurika-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_24_chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── JWT RS256 (cles generees une seule fois) ───────────────────
# Generer la paire (host) :
#   openssl genrsa -out infrastructure/secrets/jwt/jwt-private.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -in jwt-private.pem -out jwt-private-pkcs8.pem -nocrypt
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Le compose monte le dossier infrastructure/secrets/jwt/ en read-only.
JWT_ALGORITHM=RS256
JWT_ISSUER=jurika.ma
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000

# ─── Stripe TEST mode (regenere par scripts/stripe-setup-products.mjs) ─
# 1) Cree un compte sur https://dashboard.stripe.com en mode Test
# 2) Copie pk_test_*/sk_test_* depuis Developers > API keys
# 3) node scripts/stripe-setup-products.mjs --write-env  (cree les 4 prix)
# 4) stripe listen --forward-to localhost:8090/api/v1/billing/webhook/stripe
#    => copie le whsec_*
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER_MONTHLY=price_REPLACE_ME_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_REPLACE_ME_starter_yearly
STRIPE_PRICE_BUSINESS_MONTHLY=price_REPLACE_ME_business_monthly
STRIPE_PRICE_BUSINESS_YEARLY=price_REPLACE_ME_business_yearly
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_CHECKOUT_LOCALE=fr
BILLING_TVA_RATE_PERCENT=20.00
BILLING_CHECKOUT_SUCCESS_URL=http://192.168.1.42/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CHECKOUT_CANCEL_URL=http://192.168.1.42/billing
BILLING_PORTAL_RETURN_URL=http://192.168.1.42/billing
BILLING_SALES_EMAIL=contact@jurika.ai

# ─── Email — Brevo (prod) OU MailHog (capture dev) ──────────────
# Option A — Brevo (recommande pour la demo cabinet) :
#   - Cree un compte sur https://brevo.com (ex-Sendinblue)
#   - Settings > SMTP & API > SMTP > genere les credentials
#   - SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_STARTTLS=true
#   - SMTP_AUTH=true                     SMTP_USER=<adresse>  SMTP_PASSWORD=<api-key>
#   - SMTP_FROM doit etre un sender valide (verifie dans Brevo > Senders).
#
# Option B — MailHog (fallback dev, capture les emails dans une UI sur :8025) :
#   - Laisser SMTP_HOST=mailhog (service du compose), SMTP_PORT=1025, AUTH=false.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=noreply@jurika.ma
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ─── Plan limits (T3) ────────────────────────────────────────────
# true = enforce 402 PaymentRequired sur depassement quotas.
JURIKA_PLAN_LIMITS_ENABLED=true
JURIKA_PLAN_LIMITS_ENFORCEMENT_ENABLED=true

# ─── Frontend URLs ──────────────────────────────────────────────
FRONTEND_PORT=80
VITE_API_URL=http://192.168.1.42:8080/api/v1
# Variable canonique consommee par le code SPA (cf src/lib/realtimeSocket.ts).
# Doit pointer sur realtime-service (port 3000) tel que vu depuis le poste client.
VITE_REALTIME_URL=http://192.168.1.42:3000
FRONTEND_URL=http://192.168.1.42
CORS_ALLOWED_ORIGINS=http://192.168.1.42,http://192.168.1.42:80,http://localhost:80,http://localhost:5173

# ─── Encryption AES-256 ─────────────────────────────────────────
AES_SECRET_KEY=CHANGE_ME_32_chars_for_aes_256_encryption__

# ─── Observability (laisser desactive en demo si pas de stack monitoring) ─
PROMETHEUS_OPS_PASSWORD=CHANGE_ME_long_random_string
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_long_random_string
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
SENTRY_ENABLED=false

# ─── AI (optionnel, peut-etre coupe pour la demo) ──────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
SMS_PROVIDER=logger
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Firebase Push (optionnel) ──────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ─── Service Ports (defauts en accord avec gateway routing) ─────
GATEWAY_PORT=8080
DISCOVERY_PORT=8761
AUTH_SERVICE_PORT=8081
TICKET_SERVICE_PORT=8082
WORKFLOW_SERVICE_PORT=8083
DATAROOM_SERVICE_PORT=8084
AI_SERVICE_PORT=8085
SUPERVISION_SERVICE_PORT=8086
DASHBOARD_SERVICE_PORT=8087
KIE_PORT=8088
OCR_PORT=8089
BILLING_SERVICE_PORT=8090
REALTIME_SERVICE_PORT=3000

# ─── KIE / OCR / Donut ──────────────────────────────────────────
#
# ATTENTION — DEUX VARIABLES DISTINCTES, NE PAS LES CONFONDRE.
# C'est la troisieme fois que cette confusion fait tomber l'extraction CIN
# EN SILENCE : le conteneur demarre, le healthcheck passe au vert, et chaque
# extraction repond 500 parce que le modele n'a jamais ete charge.
#
#   DONUT_MODEL_DIR_HOST = chemin sur la MACHINE HOTE (source du montage).
#                          C'est celle-ci qu'on surcharge quand les poids sont
#                          ailleurs. Sous Windows : C:\chemin\vers\les\poids.
#   DONUT_MODEL_DIR      = chemin DANS LE CONTENEUR (destination du montage).
#                          Il vaut /models/donut-jurika-final et ne doit
#                          JAMAIS etre renseigne avec un chemin hote : le
#                          conteneur Linux ne sait pas lire « C:\... » et
#                          repond `OSError: Incorrect path_or_model_id`.
#
# Poids attendus dans le repertoire hote : config.json + model.safetensors +
# tokenizer*. Par defaut le compose resout l'hote en ../models/donut-jurika-final
# (relatif a infrastructure/docker-compose.services.yml).
#
# Pour verifier apres demarrage — le healthcheck ne prouve RIEN ici :
#   docker logs jurika-kie | grep "Donut charg"
# doit afficher « Donut chargé. device=cpu ».
#
# DONUT_MODEL_DIR_HOST=/srv/jurika/models/donut-jurika-final
# DONUT_MODEL_DIR=/models/donut-jurika-final   # ne surcharger que pour un autre point de montage

# Active la voie OCR rapide (docTR CPU) consommee par ai-service.
OCR_FAST_ENABLED=true
OCR_SERVICE_URL=http://ocr-service:8089

# URL kie-service consommee par dataroom-service pour extraire CIN / CN.
KIE_BASE_URL=http://kie-service:8088

# Token partage pour les ingestion serveur-a-serveur vers realtime-service
# (auth-service publie les notifications via POST /internal/notify).
INTERNAL_TOKEN=CHANGE_ME_internal_shared_token_min_24_chars
