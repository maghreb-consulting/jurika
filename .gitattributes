# Sprint 14 -- normaliser line endings cross-platform.
# Ref: D-S2-08 / D-S1-02 (Windows/CRLF vs Linux/LF).

* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.doc binary
*.xls binary
*.xlsx binary
*.pptx binary
*.zip binary
*.gz binary
*.tar binary
*.jar binary
*.class binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Source code -- force LF
*.java   text eol=lf diff=java
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.properties text eol=lf

# Scripts Windows (PowerShell) -- conserver CRLF
*.ps1    text eol=crlf
*.bat    text eol=crlf
*.cmd    text eol=crlf
