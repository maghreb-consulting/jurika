<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback partagee JURIKA (Sprint 2 / TASK 1).
    - Profil dev (defaut)        : sortie texte lisible avec correlationId.
    - Profil prod / staging      : sortie JSON (logstash encoder) consommable par Loki/ELK.
    - Champs MDC propages        : correlationId, workspaceId, userId (+ trace_id/span_id si OTel agent actif).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="jurika"/>
    <springProperty scope="context" name="appEnv" source="jurika.env" defaultValue="dev"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>workspaceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
            <customFields>{"service":"${appName}","env":"${appEnv}"}</customFields>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] [%X{correlationId:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Sprint 2 / TASK 5 — Sentry appender (WARN+). Inactif si SENTRY_DSN absent. -->
    <appender name="SENTRY" class="io.sentry.logback.SentryAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <minimumEventLevel>WARN</minimumEventLevel>
        <minimumBreadcrumbLevel>INFO</minimumBreadcrumbLevel>
    </appender>

    <springProfile name="prod,staging">
        <root level="INFO">
            <appender-ref ref="JSON"/>
            <appender-ref ref="SENTRY"/>
        </root>
        <logger name="ma.jurika" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>

    <springProfile name="!prod &amp; !staging">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="ma.jurika" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
    </springProfile>
</configuration>
