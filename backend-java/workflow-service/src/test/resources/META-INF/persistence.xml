<?xml version="1.0" encoding="UTF-8"?>
<!--
  Unite de persistance reservee aux TESTS D'INTEGRATION (TestContainers).

  Elle ne declare AUCUNE entite : les services testes (WorkflowUseCases,
  DossierIdentityQueryService) n'utilisent que des requetes natives
  (em.createNativeQuery). L'URL / user / password sont injectes a chaud par le
  test depuis le conteneur PostgreSQL — rien n'est code en dur ici.
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="workflow-it" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
