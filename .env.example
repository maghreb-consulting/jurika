# ══════════════════════════════════════════════════════════════
# JURIKA — Environment Variables
# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jurika_db
POSTGRES_USER=jurika_user
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Role d'execution des services (non proprietaire, NOSUPERUSER, NOBYPASSRLS) :
# mot de passe DEDIE, obligatoire, distinct de POSTGRES_PASSWORD (lot L0).
JURIKA_APP_PASSWORD=CHANGE_ME_jurika_app_password

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=jurika
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_VHOST=jurika

# ─── MinIO (S3-compatible) ───────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=jurika-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_UPLOADS=uploads
MINIO_BUCKET_TEMPLATES=templates

# ─── JWT ─────────────────────────────────────────────────────
# RS256 (production-grade) ou HS256 (legacy dev). Voir docs/v2/PLAN_SPRINT_1_SECURITE_PROD.md TASK 4.
JWT_ALGORITHM=RS256
# Chemins paire de cles RSA (genere par TASK 1 : openssl genrsa -out jwt-private.pem 2048).
# En dev local hors Docker : JWT_PUBLIC_KEY_PATH=infrastructure/secrets/jwt/jwt-public.pem
# Dans Docker : monte par volume sur /run/secrets/jwt/
JWT_PUBLIC_KEY_PATH=infrastructure/secrets/jwt/jwt-public.pem
JWT_PRIVATE_KEY_PATH=infrastructure/secrets/jwt/jwt-private-pkcs8.pem
JWT_ISSUER=jurika.ma
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000
# HMAC fallback (uniquement si JWT_ALGORITHM=HS256). Laisse vide en production RS256.
JWT_SECRET=CHANGE_ME_at_least_64_chars_random_string_for_jwt_signing

# ─── Spring Boot (Java Services) ────────────────────────────
SPRING_PROFILES_ACTIVE=dev
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Service Ports
GATEWAY_PORT=8080
DISCOVERY_PORT=8761
AUTH_SERVICE_PORT=8081
TICKET_SERVICE_PORT=8082
WORKFLOW_SERVICE_PORT=8083
DATAROOM_SERVICE_PORT=8084
AI_SERVICE_PORT=8085
# Lot L2 : JURIKA_CORPUS_DIR (dossier date du corpus des modeles, monte en lecture
# seule dans ai-service) est OBLIGATOIRE et se definit dans .env.local, propre a
# chaque machine (voir .env.local.server.example). Aucun repli ici : un corpus de
# test servi a la place du vrai passerait inapercu.
SUPERVISION_SERVICE_PORT=8086

# ─── Node.js (Realtime Service) ─────────────────────────────
REALTIME_SERVICE_PORT=3000
NODE_ENV=development

# ─── AI / LLM ───────────────────────────────────────────────
OPENAI_API_KEY=sk-CHANGE_ME_your_openai_api_key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ─── Email (SMTP) ───────────────────────────────────────────
# Provider de mail :
#   smtp  (defaut) → SmtpEmailSender, envoie via spring.mail (MailHog ou SMTP prod)
#   log            → LogEmailSender, imprime workspaceCode + tempPassword dans
#                    les logs auth-service. DEV UNIQUEMENT, ne JAMAIS activer en prod.
JURIKA_EMAIL_PROVIDER=smtp
#
# Recette Gmail (necessite 2FA + App Password)
# ─────────────────────────────────────────────
# 1. Active la double authentification Google : https://myaccount.google.com/security
# 2. Genere un mot de passe d'application : https://myaccount.google.com/apppasswords
#    (choisir "Autre — JURIKA dev", colle le code 16 caracteres sans espaces dans SMTP_PASSWORD)
# 3. SMTP_USER doit etre TON adresse Gmail authentifiee
# 4. SMTP_FROM doit egalement etre cette adresse (Gmail reecrit/avertit si different)
# 5. SMTP_AUTH=true et SMTP_STARTTLS=true sont OBLIGATOIRES pour Gmail
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_email@gmail.com
SMTP_PASSWORD=CHANGE_ME_app_password_16_chars
SMTP_AUTH=true
SMTP_STARTTLS=true
# IMPORTANT : avec Gmail, SMTP_FROM DOIT etre la meme adresse que SMTP_USER
# (sinon le mail part en spam ou Gmail le reecrit avec un warning "via gmail.com").
SMTP_FROM=CHANGE_ME_email@gmail.com
SMTP_FROM_NAME=JURIKA

# Recette MailHog (dev local sans Gmail) :
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_AUTH=false  SMTP_STARTTLS=false
#   (et docker run mailhog/mailhog dans infrastructure/docker-compose.yml)

# ─── Firebase (Push Notifications Mobile) ────────────────────
FIREBASE_PROJECT_ID=CHANGE_ME_firebase_project_id
FIREBASE_PRIVATE_KEY=CHANGE_ME_firebase_private_key
FIREBASE_CLIENT_EMAIL=CHANGE_ME_firebase_client_email

# ─── Frontend URLs ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=http://localhost:3000

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Encryption ─────────────────────────────────────────────
AES_SECRET_KEY=CHANGE_ME_32_chars_for_aes_256_encryption

# ─── Observability (Sprint 2 / Lot C) ───────────────────────
# Basic auth ops sur /actuator/** (Prometheus scraper). Laisser vide en dev local
# si tu ne demarres pas la stack monitoring (les endpoints actuator sont alors publics).
PROMETHEUS_OPS_PASSWORD=CHANGE_ME_long_random_string
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_long_random_string
JURIKA_ENV=dev

# OpenTelemetry sampling : 1.0 = 100% des traces (dev), 0.5 = 50% (staging), 0.1 = 10% (prod).
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318

# Sentry (Sprint 2 / TASK 5). Vide = desactive (mode dev). En prod : Doppler/AWS SM.
SENTRY_ENABLED=false
SENTRY_DSN_JAVA=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN_FRONTEND=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_RATE=0.05
VITE_SENTRY_REPLAYS_ON_ERROR_RATE=1.0
VITE_RELEASE=dev
JURIKA_RELEASE=dev

# Retention monitoring (Sprint 14 ajustera selon volume).
PROMETHEUS_RETENTION=30d
LOKI_RETENTION_PERIOD=720h
TEMPO_RETENTION=168h

# Sprint 3 / TASK 1 — Provider SMS pour 2FA OTP.
# logger (dev, par defaut) | twilio (prod). Inwi possible plus tard.
SMS_PROVIDER=logger
# Twilio (uniquement si SMS_PROVIDER=twilio). Definir via Doppler/AWS SM en prod.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Format E.164 (+14155551234) ou alpha sender ID (max 11 chars, ex JURIKA).
TWILIO_FROM_NUMBER=

# ─── Billing / Stripe (Sprint 12 + Sprint Beta + spec 2026-06-02) ─
# TEST mode UNIQUEMENT en dev. Ne JAMAIS commit de sk_live_*.
# Setup : https://dashboard.stripe.com/register puis bascule "Test mode".
# 1) API keys : Developers → API keys (pk_test_* + sk_test_*)
# 2) Lance le script idempotent pour creer produits + 4 prix :
#       node scripts/stripe-setup-products.mjs --write-env
#    Produits : JURIKA Essentiel + JURIKA Business (Entreprise sur devis).
#    Prix MAD HT (TVA 20% appliquee a la facturation) :
#      Essentiel Mensuel : 49900   centimes (lookup_key=essentiel_monthly)
#      Essentiel Annuel  : 499900  centimes (lookup_key=essentiel_yearly)
#      Business  Mensuel : 119900  centimes (lookup_key=business_monthly)
#      Business  Annuel  : 1199900 centimes (lookup_key=business_yearly)
# 3) Webhook : Developers → Webhooks → Add endpoint
#    Local : `stripe listen --forward-to localhost:8090/api/v1/billing/webhook/stripe`
#    Récupère le signing secret (whsec_*) puis colle ci-dessous.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# 4 prix obligatoires depuis Sprint Beta — generes par stripe-setup-products.mjs
STRIPE_PRICE_ESSENTIEL_MONTHLY=price_REPLACE_ME_essentiel_monthly
STRIPE_PRICE_ESSENTIEL_YEARLY=price_REPLACE_ME_essentiel_yearly
STRIPE_PRICE_BUSINESS_MONTHLY=price_REPLACE_ME_business_monthly
STRIPE_PRICE_BUSINESS_YEARLY=price_REPLACE_ME_business_yearly
# Aliases retro-compat Sprint 12 (= MONTHLY equivalents). A retirer Sprint 14.
STRIPE_PRICE_ESSENTIEL=price_REPLACE_ME_essentiel_monthly
STRIPE_PRICE_BUSINESS=price_REPLACE_ME_business_monthly
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Préfixe public exposé au frontend (Vite). Identique à STRIPE_PUBLISHABLE_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Base PG dédiée billing-service. Isolation des données financières (audit + conformité).
BILLING_DB_NAME=jurika_billing
BILLING_SERVICE_PORT=8090
# Locale Stripe Checkout + Customer Portal (Sprint 12 = fr Maroc).
STRIPE_CHECKOUT_LOCALE=fr
# TVA Maroc — calculée backend (Stripe Tax pas utilisé pour Maroc, cf. PLAN §7).
BILLING_TVA_RATE_PERCENT=20.00
# URLs retour Stripe Checkout (success / cancel)
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CHECKOUT_CANCEL_URL=http://localhost:5173/billing
BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing
# Email destinataire pour les leads plan Enterprise (POST /billing/contact-sales)
BILLING_SALES_EMAIL=contact@jurika.ai
